{
    "name": "watermark/watermark-php",
    "description": "PHP client for the Watermark API: watermark, resize and convert images, videos and PDFs.",
    "type": "library",
    "license": "MIT",
    "keywords": ["watermark", "image", "video", "pdf", "api"],
    "homepage": "https://api.watermark.ws/docs",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Watermark\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Watermark\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "spec:refresh": "@php scripts/refresh-spec.php"
    },
    "scripts-descriptions": {
        "spec:refresh": "Record the API's current openapi.json as the spec this library is checked against (spec/openapi.json and spec.sha). Run after updating the library."
    }
}
